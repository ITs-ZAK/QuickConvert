<Window x:Class="QuickConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickConvert"
        Width="800" Height="640"
        MinWidth="620" MinHeight="480"
        Icon="Assets/quickconvert.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="NavigationTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,8"
                                Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="4">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}" Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="48" Height="48"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="13"
                    VerticalAlignment="Center">
                <Viewbox Width="34" Height="34">
                    <Canvas Width="64" Height="64">
                        <Path Data="M42.5 39.5 A14 14 0 1 1 46 25 L40.6 25.2 48.6 15 57.4 24.6 52.1 24.8 A20 20 0 1 0 47 45 Z"
                              Fill="White" />
                        <Path Data="M34 35 L48 49"
                              Stroke="White"
                              StrokeThickness="6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="QuickConvert" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Konwertuj lokalnie. Bez wysyłania plików."
                           Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#63D69A" Margin="0,0,8,0" />
                    <TextBlock Text="Lokalnie • Bez chmury" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource NavigationTabControlStyle}">
            <TabItem Header="Konwertuj" Style="{StaticResource NavigationTabStyle}">
                <ScrollViewer Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="NOWA KONWERSJA" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock Text="{Binding SelectionTitle}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Dodaj jeden lub kilka plików, a pokażemy tylko wspólne formaty docelowe."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,14" />
                                <Button Content="Wybierz pliki"
                                        Command="{Binding SelectFilesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" />

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,16" />
                                <TextBlock Text="Wybierz format wyniku" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding CompatibleFormats}" Margin="0,11,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Style="{StaticResource FormatButtonStyle}"
                                                    Command="{Binding DataContext.ConvertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AnimationWarning}"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                <Expander Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}">
                                    <Expander.Header>
                                        <TextBlock Text="Więcej ustawień" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,2">
                                        <TextBlock Text="Preset: wysoka jakość — MP3 192 kb/s, H.264 CRF 20, obrazy 90." TextWrapping="Wrap" />
                                        <TextBlock Text="Wynik: obok pliku źródłowego. Oryginał zawsze pozostaje bez zmian."
                                                   Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,22,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kolejka zadań" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Postęp konwersji i pobierania pojawi się tutaj."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} zadań}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8394" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button Content="Ponów"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Pokaż plik"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Anuluj"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Historia" Style="{StaticResource NavigationTabStyle}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Ostatnie zadania" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Lokalnie przechowujemy maksymalnie 50 ostatnich wpisów."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding History}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0">
                                                <Run Text="{Binding Status}" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding CompletedAt}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Informacje" Style="{StaticResource NavigationTabStyle}">
                <ScrollViewer Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Folder pobierania" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Gotowe materiały z rozszerzenia przeglądarki znajdziesz tutaj."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" />
                                <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="12,9">
                                    <TextBlock Text="{Binding DownloadDirectory}" Foreground="{StaticResource AccentHoverBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Prywatność" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Downloader jest przeznaczony wyłącznie do materiałów, które możesz legalnie pobrać."
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="Brak telemetrii • brak chmury • GPL-3.0"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Aktualizacje i diagnostyka" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,10" />
                                <WrapPanel>
                                    <Button Content="Otwórz GitHub Releases"
                                            Command="{Binding OpenUpdateCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="Pokaż lokalny log"
                                            Command="{Binding OpenLogCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" BorderBrush="#67313C" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Strefa niebezpieczna" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Usuwa lokalną historię zadań oraz log diagnostyczny. Pliki wynikowe pozostaną bez zmian."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,12" />
                                <Button Content="Wyczyść historię i logi"
                                        Command="{Binding ClearLocalDataCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
