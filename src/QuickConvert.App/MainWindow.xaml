<Window x:Class="QuickConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickConvert" Width="720" Height="600"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="QuickConvert" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Konwertuj lokalnie. Bez wysyłania plików."
                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Konwertuj">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold" />
                                <Button Content="Wybierz pliki" Command="{Binding SelectFilesCommand}"
                                        HorizontalAlignment="Left" Margin="0,14,0,12" />
                                <TextBlock Text="Wybierz format wyniku" Foreground="{StaticResource MutedBrush}" />
                                <ItemsControl ItemsSource="{Binding CompatibleFormats}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" MinWidth="76"
                                                    Command="{Binding DataContext.ConvertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AnimationWarning}" Foreground="#FFCC73"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Expander Header="Więcej ustawień" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Preset: wysoka jakość (MP3 192 kb/s, H.264 CRF 20, obrazy 90)" />
                                        <TextBlock Text="Miejsce: obok pliku źródłowego; oryginał pozostaje bez zmian."
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kolejka" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,10" />
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7A8A" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Anuluj"
                                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Pokaż plik"
                                                        Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Ponów"
                                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Historia">
                <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" Margin="0,18,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding Status}" /><Run Text=" • " /><Run Text="{Binding CompletedAt}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Informacje">
                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="Pliki pobierane" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DownloadDirectory}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />
                    <TextBlock Text="Downloader jest przeznaczony wyłącznie do materiałów, które możesz legalnie pobrać."
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                    <TextBlock Text="Brak telemetrii • brak chmury • GPL-3.0"
                               Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding UpdateMessage}" Margin="0,18,0,6" />
                    <Button Content="Otwórz GitHub Releases" Command="{Binding OpenUpdateCommand}"
                            HorizontalAlignment="Left" />
                    <Button Content="Pokaż lokalny log" Command="{Binding OpenLogCommand}"
                            HorizontalAlignment="Left" />
                    <Button Content="Wyczyść historię i logi" Command="{Binding ClearLocalDataCommand}"
                            HorizontalAlignment="Left" Background="#A63D4D" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
